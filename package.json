{
  "name": "finbuddy",
  "private": true,
  "description": "FinBuddy monorepo: Expo app (apps/mobile), marketing site (apps/web) and shared domain code (packages/shared).",
  "license": "MIT",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "mobile": "npm run start --workspace @finbuddy/mobile",
    "mobile:ios": "npm run ios --workspace @finbuddy/mobile",
    "mobile:android": "npm run android --workspace @finbuddy/mobile",
    "mobile:web": "npm run web --workspace @finbuddy/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "web:install": "npm --prefix apps/web ci",
    "web:dev": "npm --prefix apps/web run dev",
    "web:test": "npm --prefix apps/web test -- --run",
    "web:build": "npm --prefix apps/web ci && npm --prefix apps/web run build",
    "brand:icons": "node scripts/render-icons.mjs",
    "brand:fonts": "node scripts/sync-fonts.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "vite": "^7.3.0"
  }
}
