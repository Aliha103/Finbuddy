{
  "name": "@finbuddy/web",
  "version": "0.1.0",
  "private": true,
  "description": "FinBuddy marketing site: a single page that runs the real split engine.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemap && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.js",
